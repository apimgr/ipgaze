# =============================================================================
# Build Stage - Compile Go binary (debug, no symbol stripping)
# =============================================================================
FROM --platform=$BUILDPLATFORM casjaysdev/go:latest AS builder

# Install git, bash, and delve debugger
RUN apk add --no-cache git bash
ARG TARGETARCH
RUN env -u GOBIN GOPATH=/tmp/delve-go GOOS=linux GOARCH=${TARGETARCH} go install github.com/go-delve/delve/cmd/dlv@latest \
    && mkdir -p /tmp/delve-bin \
    && cp "$(find /tmp/delve-go/bin -type f -name dlv -print -quit)" /tmp/delve-bin/dlv

ARG VERSION=dev
# BUILD_EPOCH is the single embedded time source; BuildDate is derived from it at process start
ARG BUILD_EPOCH
ARG COMMIT_ID
ARG OFFICIAL_SITE=

WORKDIR /app

# Copy go.mod first for layer caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build without stripping debug symbols
COPY . .
RUN go test ./src/common/i18n
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -buildvcs=false \
    -ldflags "-X 'main.Version=${VERSION}' -X 'main.CommitID=${COMMIT_ID}' -X 'main.BuildEpoch=${BUILD_EPOCH}' -X 'main.OfficialSite=${OFFICIAL_SITE}'" \
    -o /app/binary/ipgaze ./src

# =============================================================================
# Runtime Stage - Alpine with debugging tools
# =============================================================================
FROM alpine:latest
ARG TARGETARCH

# ARGs for build-time values (set by docker build --build-arg)
ARG VERSION=dev
ARG BUILD_DATE
ARG BUILD_EPOCH
ARG COMMIT_ID
ARG LICENSE=MIT

# No LABEL blocks — all image metadata is applied as OCI annotations at build time,
# per AI.md PART 26 and docker-rules.md.

# Upgrade base packages first so transitively-pulled libs (e.g. libcrypto3/
# libssl3) get security fixes published after the alpine:latest layer was cut
RUN apk update && apk upgrade --no-cache

# Install runtime packages plus debugging tools
RUN apk add --no-cache \
    git \
    curl \
    bash \
    tini \
    tor

# Copy binary from builder stage
COPY --from=builder /app/binary/ipgaze /usr/local/bin/ipgaze

# Copy delve debugger from builder stage
# Install uses a temporary GOPATH so Delve is cross-compiled for TARGETARCH
# and is kept separate from the application toolchain binaries.
COPY --from=builder /tmp/delve-bin/dlv /usr/local/bin/dlv

# Copy BUILD-TIME overlay (entrypoint.sh) from docker/rootfs/ into image
COPY docker/rootfs/ /

# Copy Dockerfile to image (for reference and backup)
COPY docker/Dockerfile.dev /root/Dockerfile

# Make all binaries/scripts in /usr/local/bin executable (755)
RUN chmod 755 /usr/local/bin/*

# NO directory creation, NO non-root user - binary handles ALL setup based
# on env vars, including creating its own dedicated system user and
# dropping privileges after binding privileged ports (see AI.md PART 23).
# Docker volume mounts auto-create mount points.
# Documented non-root exception (AI.md PART 26, "document exception in
# IDEA.md" clause) — see IDEA.md "Docker non-root exception".
# trivy:ignore:AVD-DS-0002

# Development image environment — debug symbols and development behavior
ENV TZ=America/New_York \
    MODE=devel \
    PORT=80 \
    DATABASE_DIR=/data/db/sqlite

# Expose internal port (always 80)
EXPOSE 80

# Stop signal for graceful shutdown
STOPSIGNAL SIGRTMIN+3

# Health check — long start period for service initialization (matches production)
HEALTHCHECK --start-period=10m --interval=5m --timeout=15s --retries=3 \
    CMD /usr/local/bin/ipgaze --status || exit 1

# Use tini as init with signal propagation
ENTRYPOINT [ "tini", "-p", "SIGTERM", "--", "/usr/local/bin/entrypoint.sh" ]
