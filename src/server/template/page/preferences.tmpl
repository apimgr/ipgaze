{{template "base" .}}
{{define "title"}}{{t .Lang "preferences.title"}} — {{.ProjectName}}{{end}}
{{define "content"}}
<h1>{{t .Lang "preferences.heading"}}</h1>
<form method="POST" action="/server/preferences">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <input type="hidden" name="redirect" value="{{.CancelURL}}">
  <input type="hidden" name="consent_form" value="1">

  <section class="section-card" aria-labelledby="preferences-appearance">
    <h2 id="preferences-appearance">{{t .Lang "preferences.display_heading"}}</h2>
    <p>{{t .Lang "preferences.intro"}}</p>
    <div class="form-group">
      <label for="preferences-theme">{{t .Lang "preferences.current_theme_label"}}</label>
      <select id="preferences-theme" name="theme" class="form-control">
        <option value="dark"{{if eq .Theme "dark"}} selected{{end}}>{{t .Lang "theme.dark"}}</option>
        <option value="light"{{if eq .Theme "light"}} selected{{end}}>{{t .Lang "theme.light"}}</option>
        <option value="auto"{{if eq .Theme "auto"}} selected{{end}}>{{t .Lang "theme.auto"}}</option>
      </select>
    </div>
    <div class="form-group">
      <label for="preferences-lang">{{t .Lang "preferences.current_lang_label"}}</label>
      <select id="preferences-lang" name="lang" class="form-control">
        {{range languages}}<option value="{{.Code}}"{{if eq .Code $.Lang}} selected{{end}}>{{.NativeName}}</option>{{end}}
      </select>
    </div>
    <div class="form-group">
      <label for="preferences-widget">{{t .Lang "preferences.default_widget_label"}}</label>
      <select id="preferences-widget" name="ipgaze_pref_widget" class="form-control">
        <option value="ip"{{if eq .DefaultWidget "ip"}} selected{{end}}>ip</option>
        <option value="country"{{if eq .DefaultWidget "country"}} selected{{end}}>country</option>
        <option value="country-iso"{{if eq .DefaultWidget "country-iso"}} selected{{end}}>country-iso</option>
        <option value="city"{{if eq .DefaultWidget "city"}} selected{{end}}>city</option>
        <option value="asn"{{if eq .DefaultWidget "asn"}} selected{{end}}>asn</option>
        <option value="json"{{if eq .DefaultWidget "json"}} selected{{end}}>json</option>
        <option value="port"{{if eq .DefaultWidget "port"}} selected{{end}}>port</option>
      </select>
    </div>
  </section>

  <section class="section-card" aria-labelledby="preferences-privacy">
    <h2 id="preferences-privacy">{{t .Lang "preferences.consent_heading"}}</h2>
    <p>{{t .Lang "preferences.consent_intro"}}</p>
    <div class="form-group">
      <label><input type="checkbox" checked disabled> {{t .Lang "preferences.consent_essential_label"}}</label>
      <p class="form-hint">{{t .Lang "cookie_consent.essential_description"}}</p>
    </div>
    <div class="form-group">
      <label for="consent-preferences"><input type="checkbox" id="consent-preferences" name="consent_preferences" value="1"{{if .ConsentPreferences}} checked{{end}}> {{t .Lang "preferences.consent_preferences_label"}}</label>
      <p class="form-hint">{{t .Lang "cookie_consent.preference_description"}}</p>
    </div>
    <div class="form-group">
      <label for="consent-analytics"><input type="checkbox" id="consent-analytics" name="consent_analytics" value="1"{{if .ConsentAnalytics}} checked{{end}}> {{t .Lang "preferences.consent_analytics_label"}}</label>
      <p class="form-hint">{{t .Lang "cookie_consent.analytics_description"}}</p>
    </div>
    {{if and .Privacy .Privacy.Data.Sold}}
    <input type="hidden" name="ccpa_opt_out" value="0">
    <div class="form-group">
      <label for="ccpa-opt-out"><input type="checkbox" id="ccpa-opt-out" name="ccpa_opt_out" value="1"{{if .CCPAOptedOut}} checked{{end}}> {{t .Lang "privacy.ccpa_do_not_sell"}}</label>
      <p class="form-hint">{{t .Lang "preferences.ccpa_intro"}}</p>
    </div>
    {{end}}
  </section>

  <section class="section-card" aria-labelledby="preferences-data">
    <h2 id="preferences-data">{{t .Lang "preferences.export_heading"}} &amp; {{t .Lang "preferences.import_heading"}}</h2>
    <p>{{t .Lang "preferences.export_intro"}}</p>
    <div class="form-group">
      <label for="preferences-export-url">{{t .Lang "preferences.export_url_label"}}</label>
      <div class="ip-display-row">
        <code class="ip-scroll select-all" id="preferences-export-url">{{.PreferencesExportURL}}</code>
        <button type="button" class="copy-btn" data-copy="{{.PreferencesExportURL}}" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy_url_aria"}}"><span class="copy-icon" aria-hidden="true">⧉</span><span class="copy-text">{{t .Lang "common.copy"}}</span></button>
      </div>
    </div>
    <div class="form-group">
      <label for="preferences-export-code">{{t .Lang "preferences.export_code_label"}}</label>
      <div class="ip-display-row">
        <code class="ip-scroll select-all" id="preferences-export-code">{{.PreferencesExportCode}}</code>
        <button type="button" class="copy-btn" data-copy="{{.PreferencesExportCode}}" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy_code_aria"}}"><span class="copy-icon" aria-hidden="true">⧉</span><span class="copy-text">{{t .Lang "common.copy"}}</span></button>
      </div>
    </div>
    <div class="form-group">
      <label for="preferences-import-code">{{t .Lang "preferences.import_paste_label"}}</label>
      <input type="text" id="preferences-import-code" name="code" class="form-control" autocomplete="off">
      <p class="form-hint">{{t .Lang "preferences.import_intro"}}</p>
    </div>
  </section>

  <div class="preferences-actions">
    <button type="submit" class="btn btn-primary">{{t .Lang "preferences.save"}}</button>
    <a class="btn btn-secondary" href="{{.CancelURL}}">{{t .Lang "common.cancel"}}</a>
    <button type="button" class="btn btn-danger" popovertarget="preferences-reset-popover">{{t .Lang "preferences.reset"}}</button>
  </div>
  <div id="preferences-reset-popover" class="modal" popover>
    <h2>{{t .Lang "preferences.reset_title"}}</h2>
    <p>{{t .Lang "preferences.reset_warning"}}</p>
    <div class="modal-footer">
      <button type="button" class="btn btn-secondary" popovertarget="preferences-reset-popover" popovertargetaction="hide">{{t .Lang "common.cancel"}}</button>
      <button type="submit" class="btn btn-danger" name="action" value="reset">{{t .Lang "preferences.erase_everything"}}</button>
    </div>
  </div>
</form>
{{end}}
