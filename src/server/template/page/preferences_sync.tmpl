{{template "base" .}}
{{define "title"}}{{t .Lang "preferences.sync_title"}} — {{.ProjectName}}{{end}}
{{define "content"}}
<header class="page-header">
  <nav class="breadcrumb" aria-label="{{t .Lang "preferences.back_to_preferences"}}"><a href="/server/preferences">← {{t .Lang "preferences.heading"}}</a></nav>
  <h1 class="page-title">{{t .Lang "preferences.sync_heading"}}</h1>
  <p class="page-lead">{{t .Lang "preferences.sync_intro"}}</p>
</header>
<section class="section-card" aria-labelledby="preferences-sync-export">
  <h2 id="preferences-sync-export">{{t .Lang "preferences.export_heading"}}</h2>
  <div class="form-group">
    <label for="preferences-export-url">{{t .Lang "preferences.export_url_label"}}</label>
    <div class="code-block"><pre><code class="copy-value" id="preferences-export-url">{{.PreferencesExportURL}}</code></pre><button type="button" class="copy-btn" data-copy="{{.PreferencesExportURL}}" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy_url_aria"}}"><span class="copy-icon" aria-hidden="true">⧉</span><span class="copy-text">{{t .Lang "common.copy"}}</span></button></div>
  </div>
  <div class="form-group">
    <label for="preferences-export-code">{{t .Lang "preferences.export_code_label"}}</label>
    <div class="code-block"><pre><code class="copy-value" id="preferences-export-code">{{.PreferencesExportCode}}</code></pre><button type="button" class="copy-btn" data-copy="{{.PreferencesExportCode}}" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "preferences.copy_code_aria"}}"><span class="copy-icon" aria-hidden="true">⧉</span><span class="copy-text">{{t .Lang "common.copy"}}</span></button></div>
  </div>
</section>
<section class="section-card" aria-labelledby="preferences-sync-import">
  <h2 id="preferences-sync-import">{{t .Lang "preferences.import_paste_label"}}</h2>
  <form method="POST" action="/server/preferences/sync">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <div class="form-group">
      <label for="preferences-import-code">{{t .Lang "preferences.import_paste_label"}}</label>
      <input type="text" id="preferences-import-code" name="code" class="form-input" autocomplete="off">
      <p class="form-hint">{{t .Lang "preferences.import_intro"}}</p>
    </div>
    <button type="submit" class="btn btn-primary">{{t .Lang "preferences.import_submit"}}</button>
  </form>
</section>
{{end}}
