{{template "base" .}}
{{define "title"}}{{t .Lang "privacy.dpo_title"}} — {{.ProjectName}}{{end}}
{{define "content"}}
<header class="page-header">
  <h1 class="page-title">{{t .Lang "privacy.dpo_title"}}</h1>
  <p class="page-lead">{{t .Lang "privacy.dpo_heading"}}</p>
</header>
<section class="section-card" aria-labelledby="dpo-contact">
  <h2 id="dpo-contact">{{t .Lang "privacy.dpo_heading"}}</h2>
  {{if .Name}}<p><strong>{{t .Lang "privacy.dpo_name"}}:</strong> {{.Name}}</p>{{end}}
  {{if .Email}}
  <p><strong>{{t .Lang "privacy.dpo_email"}}:</strong> <a href="mailto:{{.Email}}">{{.Email}}</a></p>
  {{else}}
  <p>{{t .Lang "privacy.dpo_contact_unavailable"}}</p>
  {{end}}
  <p><a href="/server/privacy">{{t .Lang "privacy.title"}}</a></p>
  <p><a href="/server/security">{{t .Lang "security.title"}}</a></p>
</section>
{{end}}
