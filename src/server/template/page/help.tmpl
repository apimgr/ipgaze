{{template "base" .}}
{{define "title"}}{{t .Lang "api_help.title"}} — {{.ProjectName}}{{end}}
{{define "content"}}
<h1>{{t .Lang "api_help.title"}}</h1>

<section class="section-card" aria-labelledby="h-basic">
  <h2 id="h-basic">{{t .Lang "api_help.basic_heading"}}</h2>
  <p>{{t .Lang "api_help.basic_intro"}}</p>
  <div class="code-block"><code>curl -q -LSsf {{.BaseURL}}/ip</code></div>
  <p>{{t .Lang "api_help.force_ip_version"}}</p>
  <div class="code-block"><code>curl -q -LSsf -4 {{.Host}}</code></div>
  <div class="code-block"><code>curl -q -LSsf -6 {{.Host}}</code></div>
</section>

<section id="features" class="section-card" aria-labelledby="help-features">
  <h2 id="help-features">{{t .Lang "help.features"}}</h2>
  <p>{{t .Lang "help.features_intro"}}</p>
</section>

<section class="section-card" aria-labelledby="h-json">
  <h2 id="h-json">{{t .Lang "api_help.json_heading"}}</h2>
  <p>{{t .Lang "api_help.json_intro"}}</p>
  <div class="code-block"><code>curl -q -LSsf {{.BaseURL}}/json</code></div>
  <p>{{t .Lang "api_help.force_json"}}</p>
  <div class="code-block"><code>curl -q -LSsf -H "Accept: application/json" {{.BaseURL}}/</code></div>
</section>

<section class="section-card" aria-labelledby="h-fields">
  <h2 id="h-fields">{{t .Lang "api_help.fields_heading"}}</h2>
  <p>{{t .Lang "api_help.fields_intro"}}</p>
  <div class="code-block"><code>curl -q -LSsf {{.BaseURL}}/country</code></div>
  <div class="code-block"><code>curl -q -LSsf {{.BaseURL}}/country-iso</code></div>
  <div class="code-block"><code>curl -q -LSsf {{.BaseURL}}/city</code></div>
  <div class="code-block"><code>curl -q -LSsf {{.BaseURL}}/coordinates</code></div>
  <div class="code-block"><code>curl -q -LSsf {{.BaseURL}}/asn</code></div>
  <div class="code-block"><code>curl -q -LSsf {{.BaseURL}}/asn-org</code></div>
</section>

<section class="section-card" aria-labelledby="h-lookup">
  <h2 id="h-lookup">{{t .Lang "api_help.lookup_heading"}}</h2>
  <p>{{t .Lang "api_help.lookup_intro"}}</p>
  <div class="code-block"><code>curl -q -LSsf {{.BaseURL}}/8.8.8.8</code></div>
  <div class="code-block"><code>curl -q -LSsf {{.BaseURL}}/8.8.8.8/json</code></div>
  <div class="code-block"><code>curl -q -LSsf {{.BaseURL}}/2001:4860:4860::8888/json</code></div>
</section>

<section class="section-card" aria-labelledby="h-port">
  <h2 id="h-port">{{t .Lang "api_help.port_heading"}}</h2>
  <p>{{t .Lang "api_help.port_intro"}}</p>
  <div class="code-block"><code>curl -q -LSsf {{.BaseURL}}/port/22</code></div>
  <div class="code-block"><code>curl -q -LSsf {{.BaseURL}}/port/443</code></div>
</section>

<section class="section-card" aria-labelledby="h-api">
  <h2 id="h-api">{{t .Lang "api_help.formats_heading"}}</h2>
  <ul>
    <li><strong>{{t .Lang "api_help.formats_plain_label"}}</strong> — {{t .Lang "api_help.formats_plain_desc"}}</li>
    <li><strong>{{t .Lang "api_help.formats_json_label"}}</strong> — <code>Accept: application/json</code> {{t .Lang "api_help.formats_json_mid"}} <code>/json</code> {{t .Lang "api_help.formats_json_suffix"}}</li>
    <li><strong>{{t .Lang "api_help.formats_html_label"}}</strong> — {{t .Lang "api_help.formats_html_desc_pre"}} <code>Accept: text/html</code></li>
  </ul>
  <p>{{t .Lang "api_help.append_pre"}} <code>.txt</code> {{t .Lang "api_help.append_post"}}
    <code>curl -q -LSsf {{.BaseURL}}/country.txt</code>
  </p>
</section>

{{if and .TorEnabled .TorRunning .OnionAddress}}
<section id="tor-access" class="section-card tor-access" aria-labelledby="tor-access-heading">
  <h2 id="tor-access-heading">{{t .Lang "help.tor_access"}}</h2>
  <p>{{t .Lang "api_help.tor_access_intro"}}</p>

  <h3>{{t .Lang "api_help.tor_address_heading"}}</h3>
  <div class="onion-address-row">
    <code class="code-content onion-address">{{.OnionAddress}}</code>
    <button type="button" class="copy-btn copy-value" data-copy="{{.OnionAddress}}" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "common.copy_onion_aria"}}">
      <span class="copy-icon" aria-hidden="true">⧉</span>
      <span class="copy-text">{{t .Lang "common.copy"}}</span>
    </button>
  </div>

  <h3>{{t .Lang "api_help.tor_connect_heading"}}</h3>
  <ol>
    <li>{{t .Lang "api_help.tor_step1_pre"}} <a href="https://www.torproject.org/download/" target="_blank" rel="noopener">{{t .Lang "api_help.tor_step1_link"}}</a></li>
    <li>{{t .Lang "api_help.tor_step2"}}</li>
    <li>{{t .Lang "api_help.tor_step3"}}</li>
  </ol>

  <p class="note">{{t .Lang "api_help.tor_note"}}</p>
</section>
{{end}}

{{if and .I2PEnabled .I2PRunning .I2PAddress}}
<section id="i2p-access" class="section-card i2p-access" aria-labelledby="i2p-access-heading">
  <h2 id="i2p-access-heading">{{t .Lang "help.i2p_access"}}</h2>
  <p>{{t .Lang "api_help.i2p_access_intro"}}</p>

  <h3>{{t .Lang "api_help.i2p_address_heading"}}</h3>
  <div class="i2p-address-row">
    <code class="code-content i2p-address">{{.I2PAddress}}</code>
    <button type="button" class="copy-btn copy-value" data-copy="{{.I2PAddress}}" data-copied-label="{{t .Lang "common.copied"}}" aria-label="{{t .Lang "common.copy_i2p_aria"}}">
      <span class="copy-icon" aria-hidden="true">⧉</span>
      <span class="copy-text">{{t .Lang "common.copy"}}</span>
    </button>
  </div>

  <h3>{{t .Lang "api_help.i2p_connect_heading"}}</h3>
  <ol>
    <li>{{t .Lang "api_help.i2p_step1_pre"}} <a href="https://geti2p.net/en/download" target="_blank" rel="noopener">{{t .Lang "api_help.i2p_step1_link_i2p"}}</a> {{t .Lang "api_help.i2p_step1_or"}} <a href="https://i2pd.website/" target="_blank" rel="noopener">{{t .Lang "api_help.i2p_step1_link_i2pd"}}</a> {{t .Lang "api_help.i2p_step1_post"}}</li>
    <li>{{tf .Lang "api_help.i2p_step2" "proxy" "127.0.0.1:4444"}}</li>
    <li>{{t .Lang "api_help.i2p_step3"}}</li>
  </ol>

  <p class="note">{{t .Lang "api_help.i2p_note"}}</p>
</section>
{{end}}

<section class="section-card" aria-labelledby="h-api-docs">
  <h2 id="h-api-docs">{{t .Lang "api_help.api_docs"}}</h2>
  <ul>
    <li><a href="/server/docs/swagger">{{t .Lang "swagger.swagger_description"}}</a></li>
    <li><a href="/server/docs/graphql">{{t .Lang "swagger.graphql_description"}}</a></li>
    {{if .MCPEnabled}}<li><a href="/server/help/mcp">{{t .Lang "api_help.mcp_guide"}}</a></li>{{end}}
  </ul>
</section>

<section class="section-card" aria-labelledby="h-rate">
  <h2 id="h-rate">{{t .Lang "api_help.rate_heading"}}</h2>
  <p>{{t .Lang "api_help.rate_body_pre"}} <code>429</code> {{t .Lang "api_help.rate_body_post"}}</p>
</section>

<section id="faq" class="section-card" aria-labelledby="help-faq">
  <h2 id="help-faq">{{t .Lang "help.faq"}}</h2>
  <h3>{{t .Lang "help.faq_api_key_question"}}</h3>
  <p>{{t .Lang "help.faq_api_key_answer"}}</p>
  <h3>{{t .Lang "help.faq_lookup_question"}}</h3>
  <p>{{t .Lang "help.faq_lookup_answer"}} <code>/8.8.8.8/json</code></p>
  <h3>{{t .Lang "help.faq_geoip_question"}}</h3>
  <p>{{t .Lang "help.faq_geoip_answer"}}</p>
</section>

<section id="troubleshooting" class="section-card" aria-labelledby="help-troubleshooting">
  <h2 id="help-troubleshooting">{{t .Lang "help.troubleshooting"}}</h2>
  <h3><code>429</code> {{t .Lang "help.troubleshooting_rate_title"}}</h3>
  <p>{{t .Lang "help.troubleshooting_rate_body"}}</p>
  <h3><code>404</code> {{t .Lang "help.troubleshooting_route_title"}}</h3>
  <p>{{t .Lang "help.troubleshooting_route_body"}}</p>
</section>
{{end}}
