{{template "base" .}}
{{define "title"}}{{t .Lang "security.title"}} — {{.ProjectName}}{{end}}
{{define "content"}}
<h1>{{t .Lang "security.title"}}</h1>
<section class="section-card">
  <p>{{t .Lang "security.intro"}}</p>
  {{if .SecurityEmail}}
  <p>{{tf .Lang "security.report_email" "email" .SecurityEmail}}</p>
  {{end}}
  <p>{{t .Lang "security.report_github"}} <a href="{{.RepoURL}}/security/advisories/new">{{t .Lang "security.report_github_link"}}</a>.</p>
  <h2>{{t .Lang "security.txt_heading"}}</h2>
  <p>{{t .Lang "security.txt_body"}} <a href="/.well-known/security.txt">/.well-known/security.txt</a>.</p>
</section>
{{end}}
