{{template "base" .}}
{{define "title"}}{{t .Lang "contact.title"}} — {{.ProjectName}}{{end}}
{{define "contact-hidden-fields"}}
<input type="hidden" name="name" value="{{.ContactForm.Name}}">
<input type="hidden" name="email" value="{{.ContactForm.Email}}">
{{if ne .ContactForm.Type "security"}}
<input type="hidden" name="subject" value="{{.ContactForm.Subject}}">
<input type="hidden" name="message" value="{{.ContactForm.Message}}">
{{end}}
<input type="hidden" name="type" value="{{.ContactForm.Type}}">
{{if or (eq .ContactForm.Type "abuse") (eq .ContactForm.Type "dmca")}}
<input type="hidden" name="reported_url" value="{{.ContactForm.ReportedURL}}">
{{end}}
{{if eq .ContactForm.Type "abuse"}}
<input type="hidden" name="reason" value="{{.ContactForm.Reason}}">
{{end}}
{{if eq .ContactForm.Type "dmca"}}
<input type="hidden" name="copyrighted_work" value="{{.ContactForm.CopyrightedWork}}">
<input type="hidden" name="good_faith" value="{{if .ContactForm.GoodFaith}}true{{else}}false{{end}}">
<input type="hidden" name="accuracy" value="{{if .ContactForm.Accuracy}}true{{else}}false{{end}}">
<input type="hidden" name="signature" value="{{.ContactForm.Signature}}">
{{end}}
{{if eq .ContactForm.Type "privacy"}}
<input type="hidden" name="request_kind" value="{{.ContactForm.RequestKind}}">
{{end}}
{{if eq .ContactForm.Type "security"}}
<input type="hidden" name="security_id" value="{{.ContactForm.SecurityID}}">
<input type="hidden" name="credit_handle" value="{{.ContactForm.Handle}}">
<input type="hidden" name="researcher_gpg" value="{{.ContactForm.ResearcherGPG}}">
<input type="hidden" name="affected_component" value="{{.ContactForm.AffectedComponent}}">
<input type="hidden" name="affected_endpoint" value="{{.ContactForm.AffectedEndpoint}}">
<input type="hidden" name="severity" value="{{.ContactForm.Severity}}">
<input type="hidden" name="summary" value="{{.ContactForm.Summary}}">
<input type="hidden" name="steps_to_reproduce" value="{{.ContactForm.StepsToReproduce}}">
<input type="hidden" name="impact" value="{{.ContactForm.Impact}}">
<input type="hidden" name="suggested_fix" value="{{.ContactForm.SuggestedFix}}">
<input type="hidden" name="cve_requested" value="{{if .ContactForm.CVERequested}}true{{else}}false{{end}}">
<input type="hidden" name="disclosure_days" value="{{.ContactForm.DisclosureDays}}">
<input type="hidden" name="credit_preference" value="{{.ContactForm.CreditPreference}}">
<input type="hidden" name="coordinated_disclosure_agreement" value="{{if .ContactForm.CoordinatedAgreement}}true{{else}}false{{end}}">
{{end}}
{{end}}
{{define "contact-captcha"}}
{{if eq .CaptchaProvider "simple"}}
<input type="hidden" name="captcha_id" value="{{.CaptchaToken}}">
<div class="form-group">
  <label for="captcha">{{t .Lang "contact.captcha"}} <span>({{t .Lang "contact.required"}})</span></label>
  <p id="captcha-question">{{.CaptchaQuestion}}</p>
  <input type="text" id="captcha" name="captcha_answer" class="form-control" required autocomplete="off">
</div>
{{else if eq .CaptchaProvider "recaptcha"}}
<div class="form-group">
  <div class="g-recaptcha" data-sitekey="{{.CaptchaSiteKey}}"></div>
  <noscript><input type="hidden" name="captcha_id" value="{{.CaptchaToken}}"><label for="captcha-fallback">{{.CaptchaQuestion}}</label><input type="text" id="captcha-fallback" name="captcha_answer" required autocomplete="off"></noscript>
</div>
<script async defer src="https://www.google.com/recaptcha/api.js"></script>
{{else if eq .CaptchaProvider "hcaptcha"}}
<div class="form-group">
  <div class="h-captcha" data-sitekey="{{.CaptchaSiteKey}}"></div>
  <noscript><input type="hidden" name="captcha_id" value="{{.CaptchaToken}}"><label for="captcha-fallback">{{.CaptchaQuestion}}</label><input type="text" id="captcha-fallback" name="captcha_answer" required autocomplete="off"></noscript>
</div>
<script async defer src="https://js.hcaptcha.com/1/api.js"></script>
{{end}}
{{end}}
{{define "content"}}
<header class="page-header">
  <h1 class="page-title">{{if .ContactForm.Type}}{{t .Lang (printf "contact.type_%s" .ContactForm.Type)}}{{else}}{{t .Lang "contact.title"}}{{end}}</h1>
  <p class="page-lead">{{t .Lang "contact.purpose"}}</p>
</header>
{{if .ContactSubmitted}}
<section class="section-card" role="status" aria-labelledby="contact-section-1">
  <h2 id="contact-section-1">{{t .Lang "contact.thanks_title"}}</h2>
  <p>{{t .Lang "contact.thanks_body"}}</p>
</section>
{{else if .SecurityReportSubmitted}}
<section class="section-card" role="status" aria-labelledby="contact-section-2">
  <h2 id="contact-section-2">{{t .Lang "contact.report_received"}}</h2>
  <p>{{t .Lang "contact.report_received_body"}}</p>
  <p>{{t .Lang "contact.tracking_id"}}: <code>{{.SecurityReportTrackingID}}</code></p>
</section>
{{else if .ContactReview}}
<section class="section-card" aria-labelledby="contact-review-heading">
    <h2 id="contact-review-heading">{{t .Lang "contact.review_title"}}</h2>
    {{if .ContactReviewMessage}}<p class="form-error" role="alert">{{.ContactReviewMessage}}</p>{{end}}
    <p><strong>{{.ContactForm.Email}}</strong></p>
    <p><strong>{{t .Lang "contact.type_label"}}:</strong> {{t .Lang (printf "contact.type_%s" .ContactForm.Type)}}</p>
    <p><strong>{{t .Lang "contact.subject"}}:</strong> {{.ContactForm.Subject}}</p>
    <form method="POST" action="/server/contact">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="hidden" name="form_token" value="{{.ContactFormToken}}">
      <input type="hidden" name="website" value="">
      <input type="hidden" name="step" value="confirm">
      <input type="hidden" name="review_token" value="{{.ContactReviewToken}}">
      {{template "contact-hidden-fields" .}}
      <label class="contact-confirm"><input type="checkbox" name="confirmed" value="true" required> {{t .Lang "contact.review_confirm"}}</label>
      <button type="submit" class="btn btn-primary">{{t .Lang "contact.confirm_report"}}</button>
    </form>
    <form method="POST" action="/server/contact">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="hidden" name="form_token" value="{{.ContactFormToken}}">
      <input type="hidden" name="website" value="">
      <input type="hidden" name="step" value="edit">
      {{template "contact-hidden-fields" .}}
      <button type="submit" class="btn btn-secondary">{{t .Lang "contact.edit_report"}}</button>
    </form>
</section>
{{else if and .CSRFToken .ContactForm.Type}}
<section class="section-card" aria-labelledby="contact-form-heading">
  <h2 id="contact-form-heading">{{t .Lang "contact.form_heading"}}</h2>
  {{if .ContactError}}<p class="form-error" role="alert">{{.ContactError}}</p>{{end}}
  <form method="POST" action="/server/contact">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <input type="hidden" name="form_token" value="{{.ContactFormToken}}">
    <input type="hidden" name="step" value="submit">
    <div class="sr-only contact-honeypot" aria-hidden="true">
      <label for="website">{{t .Lang "contact.honeypot"}}</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
    </div>
    <input type="hidden" name="type" value="{{.ContactForm.Type}}">
    {{if eq .ContactForm.Type "security"}}
    <input type="hidden" name="security_id" value="{{.SecurityID}}">
    <p>{{t .Lang "contact.security_report_intro"}}</p>
    {{end}}
    <div class="form-group"><label for="name">{{t .Lang "contact.name"}} <span>({{t .Lang "contact.required"}})</span></label><input type="text" id="name" name="name" class="form-control" maxlength="100" value="{{.ContactForm.Name}}" required></div>
    <div class="form-group"><label for="email">{{t .Lang "contact.email"}} <span>({{t .Lang "contact.required"}})</span></label><input type="email" id="email" name="email" class="form-control" maxlength="254" value="{{.ContactForm.Email}}" required></div>
    {{if or (eq .ContactForm.Type "abuse") (eq .ContactForm.Type "dmca")}}
    <div class="form-group"><label for="reported_url">{{t .Lang "contact.reported_url"}} <span>({{t .Lang "contact.required"}})</span></label><input type="url" id="reported_url" name="reported_url" class="form-control" maxlength="2048" value="{{.ContactForm.ReportedURL}}" required><small>{{tf .Lang "contact.reported_url_help" .Host}}</small></div>
    {{end}}
    {{if eq .ContactForm.Type "abuse"}}
    <div class="form-group"><label for="reason">{{t .Lang "contact.reason"}} <span>({{t .Lang "contact.required"}})</span></label><select id="reason" name="reason" class="form-control" required><option value="">{{t .Lang "contact.choose_reason"}}</option><option value="illegal_content">{{t .Lang "contact.reason_illegal_content"}}</option><option value="terms_violation">{{t .Lang "contact.reason_terms_violation"}}</option><option value="harassment">{{t .Lang "contact.reason_harassment"}}</option><option value="malware_phishing">{{t .Lang "contact.reason_malware_phishing"}}</option><option value="other">{{t .Lang "contact.other"}}</option></select></div>
    {{end}}
    {{if eq .ContactForm.Type "dmca"}}
    <div class="form-group"><label for="copyrighted_work">{{t .Lang "contact.copyrighted_work"}} <span>({{t .Lang "contact.required"}})</span></label><textarea id="copyrighted_work" name="copyrighted_work" class="form-control" maxlength="2000" required>{{.ContactForm.CopyrightedWork}}</textarea></div>
    <div class="form-group"><label><input type="checkbox" name="good_faith" value="true" required {{if .ContactForm.GoodFaith}}checked{{end}}> {{t .Lang "contact.good_faith_statement"}} <span>({{t .Lang "contact.required"}})</span>: {{t .Lang "contact.good_faith_text"}}</label></div>
    <div class="form-group"><label><input type="checkbox" name="accuracy" value="true" required {{if .ContactForm.Accuracy}}checked{{end}}> {{t .Lang "contact.accuracy_statement"}} <span>({{t .Lang "contact.required"}})</span>: {{t .Lang "contact.accuracy_text"}}</label></div>
    <div class="form-group"><label for="signature">{{t .Lang "contact.signature"}} <span>({{t .Lang "contact.required"}})</span></label><input type="text" id="signature" name="signature" class="form-control" maxlength="100" value="{{.ContactForm.Signature}}" required></div>
    {{end}}
    {{if eq .ContactForm.Type "privacy"}}
    <div class="form-group"><label for="request_kind">{{t .Lang "contact.request_kind"}} <span>({{t .Lang "contact.required"}})</span></label><select id="request_kind" name="request_kind" class="form-control" required><option value="">{{t .Lang "contact.choose_request"}}</option><option value="access">{{t .Lang "contact.request_access"}}</option><option value="export">{{t .Lang "contact.request_export"}}</option><option value="deletion">{{t .Lang "contact.request_deletion"}}</option><option value="correction">{{t .Lang "contact.request_correction"}}</option><option value="opt_out">{{t .Lang "contact.request_opt_out"}}</option><option value="other">{{t .Lang "contact.other"}}</option></select></div>
    {{end}}
    {{if eq .ContactForm.Type "security"}}
    <fieldset class="form-group"><legend>{{t .Lang "contact.report_details"}}</legend>
      <div class="form-group"><label for="credit-handle">{{t .Lang "contact.researcher_handle"}} <span>({{t .Lang "contact.optional"}})</span></label><input type="text" id="credit-handle" name="credit_handle" class="form-control" maxlength="100" value="{{.ContactForm.Handle}}"><small>{{t .Lang "contact.credit_handle_help"}}</small></div>
      <div class="form-group"><label for="researcher-gpg">{{t .Lang "contact.researcher_key"}}</label><textarea id="researcher-gpg" name="researcher_gpg" class="form-control" maxlength="16384">{{.ContactForm.ResearcherGPG}}</textarea></div>
      <div class="form-group"><label for="affected-component">{{t .Lang "contact.affected_component"}} <span>({{t .Lang "contact.required"}})</span></label><input type="text" id="affected-component" name="affected_component" class="form-control" maxlength="255" value="{{.ContactForm.AffectedComponent}}" required></div>
      <div class="form-group"><label for="affected-endpoint">{{t .Lang "contact.affected_endpoint"}}</label><input type="text" id="affected-endpoint" name="affected_endpoint" class="form-control" maxlength="2048" value="{{.ContactForm.AffectedEndpoint}}"></div>
      <div class="form-group"><label for="severity">{{t .Lang "contact.severity"}} <span>({{t .Lang "contact.required"}})</span></label><select id="severity" name="severity" class="form-control" required><option value="critical">{{t .Lang "contact.severity_critical"}}</option><option value="high">{{t .Lang "contact.severity_high"}}</option><option value="medium">{{t .Lang "contact.severity_medium"}}</option><option value="low">{{t .Lang "contact.severity_low"}}</option><option value="informational">{{t .Lang "contact.severity_informational"}}</option></select></div>
      <div class="form-group"><label for="summary">{{t .Lang "contact.vulnerability_summary"}} <span>({{t .Lang "contact.required"}})</span></label><input type="text" id="summary" name="summary" class="form-control" maxlength="200" value="{{.ContactForm.Summary}}" required></div>
      <div class="form-group"><label for="steps-to-reproduce">{{t .Lang "contact.reproduction_steps"}} <span>({{t .Lang "contact.required"}})</span></label><textarea id="steps-to-reproduce" name="steps_to_reproduce" class="form-control" maxlength="10000" required>{{.ContactForm.StepsToReproduce}}</textarea></div>
      <div class="form-group"><label for="impact">{{t .Lang "contact.impact"}} <span>({{t .Lang "contact.required"}})</span></label><textarea id="impact" name="impact" class="form-control" maxlength="5000" required>{{.ContactForm.Impact}}</textarea></div>
      <div class="form-group"><label for="suggested-fix">{{t .Lang "contact.suggested_fix"}}</label><textarea id="suggested-fix" name="suggested_fix" class="form-control" maxlength="5000">{{.ContactForm.SuggestedFix}}</textarea></div>
      <label><input type="checkbox" name="cve_requested" value="true" {{if .ContactForm.CVERequested}}checked{{end}}> {{t .Lang "contact.request_cve"}} <span>({{t .Lang "contact.optional"}})</span></label>
      <div class="form-group"><label for="disclosure-days">{{t .Lang "contact.disclosure_period"}}</label><input type="number" id="disclosure-days" name="disclosure_days" min="1" max="365" value="{{.ContactForm.DisclosureDays}}"></div>
      <div class="form-group"><label for="credit-preference">{{t .Lang "contact.credit_preference"}} <span>({{t .Lang "contact.required"}})</span></label><select id="credit-preference" name="credit_preference" required><option value="real_name">{{t .Lang "contact.credit_real_name"}}</option><option value="handle">{{t .Lang "contact.credit_handle"}}</option><option value="no">{{t .Lang "contact.credit_no"}}</option><option value="anonymous">{{t .Lang "contact.credit_anonymous"}}</option></select></div>
      <label><input type="checkbox" name="coordinated_disclosure_agreement" value="true" {{if .ContactForm.CoordinatedAgreement}}checked{{end}} required> {{t .Lang "contact.coordinated_disclosure_agreement"}} <span>({{t .Lang "contact.required"}})</span></label>
    </fieldset>
    {{end}}
    {{if ne .ContactForm.Type "security"}}
    <div class="form-group"><label for="subject">{{t .Lang "contact.subject"}} <span>({{t .Lang "contact.required"}})</span></label><input type="text" id="subject" name="subject" class="form-control" maxlength="200" value="{{.ContactForm.Subject}}" required></div>
    <div class="form-group"><label for="message">{{t .Lang "contact.message"}} <span>({{t .Lang "contact.required"}})</span></label><textarea id="message" name="message" class="form-control" maxlength="5000" rows="5" required>{{.ContactForm.Message}}</textarea></div>
    {{end}}
    {{template "contact-captcha" .}}
    <button type="submit" class="btn btn-primary">{{t .Lang "contact.review_report"}}</button>
  </form>
</section>
{{end}}
{{if not .ContactSubmitted}}{{if not .SecurityReportSubmitted}}
{{if .ContactChooser}}
<section class="section-card" aria-labelledby="contact-chooser-heading">
  <h2 id="contact-chooser-heading">{{t .Lang "contact.choose_type"}}</h2>
  <ul>
    <li><a href="/server/contact?type=abuse">{{t .Lang "contact.action_abuse"}}</a></li>
    <li><a href="/server/contact?type=dmca">{{t .Lang "contact.action_dmca"}}</a></li>
    <li><a href="/server/contact?type=privacy">{{t .Lang "contact.action_privacy"}}</a></li>
    {{if .SecurityReportMode}}<li><a href="/server/contact?type=security&amp;security_id={{.SecurityID}}">{{t .Lang "contact.action_security"}}</a></li>{{end}}
  </ul>
</section>
{{end}}
<p>{{t .Lang "contact.security_pointer_pre"}} <a href="/server/security">{{t .Lang "contact.security_pointer_link"}}</a>.</p>
{{end}}{{end}}
{{end}}
