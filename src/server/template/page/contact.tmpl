{{template "base" .}}
{{define "title"}}{{t .Lang "contact.title"}} — {{.ProjectName}}{{end}}
{{define "content"}}
<h1>{{t .Lang "contact.title"}}</h1>
<section class="section-card">
  <p>{{t .Lang "contact.support_intro"}}</p>
  {{if .CSRFToken}}
  <h2>{{t .Lang "contact.form_heading"}}</h2>
  <form method="POST" action="/server/contact">
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
    <div class="form-group">
      <label for="name">{{t .Lang "contact.name"}}</label>
      <input type="text" id="name" name="name" class="form-control" required
             aria-describedby="name-error">
      <span id="name-error" class="field-error" role="alert">{{t .Lang "errors.required"}}</span>
    </div>
    <div class="form-group">
      <label for="email">{{t .Lang "contact.email"}}</label>
      <input type="email" id="email" name="email" class="form-control" required
             aria-describedby="email-error">
      <span id="email-error" class="field-error" role="alert">{{t .Lang "errors.invalid_email"}}</span>
    </div>
    <div class="form-group">
      <label for="subject">{{t .Lang "contact.subject"}}</label>
      <input type="text" id="subject" name="subject" class="form-control" required
             aria-describedby="subject-error">
      <span id="subject-error" class="field-error" role="alert">{{t .Lang "errors.required"}}</span>
    </div>
    <div class="form-group">
      <label for="message">{{t .Lang "contact.message"}}</label>
      <textarea id="message" name="message" class="form-control" rows="5" required
                aria-describedby="message-error"></textarea>
      <span id="message-error" class="field-error" role="alert">{{t .Lang "errors.required"}}</span>
    </div>
    <button type="submit" id="contact-send-btn" class="btn btn-primary" data-loading-text="{{t .Lang "contact.sending"}}">{{t .Lang "contact.send"}}</button>
  </form>
  {{end}}
  <h2>{{t .Lang "contact.security_issues"}}</h2>
  <p>{{t .Lang "contact.security_issues_body"}} <a href="/server/security">{{t .Lang "contact.security_policy_link"}}</a>.</p>
  <h2>{{t .Lang "contact.abuse_reports"}}</h2>
  {{if .AbuseEmail}}
  <p>{{tf .Lang "contact.abuse_reports_body_email" "email" .AbuseEmail}}</p>
  {{else}}
  <p>{{t .Lang "contact.abuse_reports_body"}}</p>
  {{end}}
  <p>{{t .Lang "contact.github"}}: <a href="{{.RepoURL}}">{{.RepoURL}}</a></p>
</section>
{{end}}
