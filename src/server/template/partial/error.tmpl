{{define "error"}}
<header class="page-header">
  <h1 class="page-title">{{.Code}} {{.Title}}</h1>
  <p class="page-lead">{{.Message}}</p>
</header>
<section class="section-card" aria-labelledby="error-details-heading" role="alert" aria-live="assertive">
  <h2 id="error-details-heading">{{t .Lang "errors.details"}}</h2>
  {{if .RequestID}}
  <p>{{t .Lang "errors.request_id_label"}}: <code>{{.RequestID}}</code></p>
  {{end}}
  <a href="/" class="btn btn-primary">← {{t .Lang "common.return_home"}}</a>
</section>
{{end}}
