{{define "announcement_banner"}}
{{- if .Announcements}}
{{range .Announcements}}
<div class="site-banner site-banner-{{.Type}}" role="{{if or (eq .Type "warning") (eq .Type "error")}}alert{{else}}status{{end}}" data-announcement-id="{{.ID}}">
  <span class="site-banner-icon" aria-hidden="true">{{if eq .Type "warning"}}⚠️{{else if eq .Type "error"}}❌{{else if eq .Type "success"}}✅{{else}}ℹ️{{end}}</span>
  <span class="site-banner-text">{{if .Title}}<strong>{{.Title}}</strong> {{end}}{{.Message}}</span>
  {{if .Dismissible}}
  <form method="post" action="/announcements/dismiss" class="site-banner-dismiss">
    <input type="hidden" name="id" value="{{.ID}}">
    <button type="submit" class="site-banner-close" aria-label="{{t $.Lang "announcements.dismiss_aria"}}">&times;</button>
  </form>
  {{end}}
</div>
{{end}}
{{- end}}
{{end}}
