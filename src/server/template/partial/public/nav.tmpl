{{define "nav"}}
<nav id="navigation" class="site-nav" role="navigation" aria-label="{{t .Lang "nav.main_navigation"}}">
  <input type="checkbox" id="nav-toggle" class="nav-checkbox" aria-expanded="false" aria-controls="nav-panel">
  <div class="container nav-inner">
    <a href="/" class="nav-logo" aria-label="{{tf .Lang "nav.home_aria" "app" .ProjectName}}">
      <span class="nav-brand">{{.ProjectName}}</span>
    </a>
    <ul class="nav-links" role="list">
      <li><a href="/">{{t .Lang "nav.home"}}</a></li>
      <li><a href="/server/about">{{t .Lang "nav.about"}}</a></li>
      <li><a href="/server/healthz">{{t .Lang "nav.status"}}</a></li>
    </ul>
    <div class="header-actions nav-actions">
      <label for="nav-toggle" class="nav-burger" aria-label="{{t .Lang "nav.toggle_navigation"}}">☰</label>
      <a href="/server/preferences" class="header-link" aria-label="{{t .Lang "nav.preferences"}}" title="{{t .Lang "nav.preferences"}}">
        <span class="icon-preferences" aria-hidden="true">⚙️</span>
      </a>
      <form action="/server/preferences" method="post" class="theme-toggle-form">
        {{ if .CSRFToken }}
        <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
        {{ end }}
        <input type="hidden" name="theme" value="{{ nextTheme .Theme }}">
        <button type="submit" class="btn btn-icon theme-button" title="{{t .Lang "theme.toggle"}}" aria-label="{{tf .Lang "theme.toggle_aria" "theme" (t .Lang (printf "theme.%s" .Theme))}}">
          <span class="theme-icon">{{ if eq .Theme "light" }}☀️{{ else if eq .Theme "auto" }}🔄{{ else }}🌙{{ end }}</span>
        </button>
      </form>
    </div>
  </div>
  <div class="nav-panel" id="nav-panel">
    <div class="container">
      <ul role="list">
        <li><a href="/">{{t .Lang "nav.home"}}</a></li>
        <li><a href="/server/about">{{t .Lang "nav.about"}}</a></li>
        <li><a href="/server/healthz">{{t .Lang "nav.status"}}</a></li>
      </ul>
    </div>
  </div>
  <label for="nav-toggle" class="nav-overlay" aria-hidden="true"></label>
</nav>
{{end}}
