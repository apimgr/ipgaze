{{define "header"}}
<header id="navigation" class="header" role="banner">
  <a href="/" class="site-brand" aria-label="{{tf .Lang "nav.home_aria" "app" .ProjectName}}">{{.ProjectName}}</a>
  <nav class="nav-links" role="navigation" aria-label="{{t .Lang "nav.main_navigation"}}">
    {{template "site_navigation_links" .}}
  </nav>
  <label for="nav-toggle" class="nav-burger" aria-label="{{t .Lang "nav.toggle_navigation"}}" title="{{t .Lang "nav.toggle_navigation"}}">☰</label>
  <div class="header-actions">
    <a href="/server/preferences" class="header-link" aria-label="{{t .Lang "nav.preferences"}}" title="{{t .Lang "nav.preferences"}}">
      <svg class="icon-preferences" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm9 4a7.9 7.9 0 0 0-.1-1.2l2-1.5-2-3.5-2.4 1a8.6 8.6 0 0 0-2-1.2L16.1 3h-4.2l-.4 2.6a8.6 8.6 0 0 0-2 1.2l-2.4-1-2 3.5 2 1.5a7.9 7.9 0 0 0 0 2.4l-2 1.5 2 3.5 2.4-1a8.6 8.6 0 0 0 2 1.2l.4 2.6h4.2l.4-2.6a8.6 8.6 0 0 0 2-1.2l2.4 1 2-3.5-2-1.5A7.9 7.9 0 0 0 21 12Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
    </a>
    <form action="/server/preferences" method="post" class="theme-toggle-form">
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <input type="hidden" name="theme" value="{{nextTheme .Theme}}">
      <button type="submit" class="btn btn-icon theme-button" title="{{t .Lang "theme.toggle"}}" aria-label="{{tf .Lang "theme.toggle_aria" "theme" (t .Lang (printf "theme.%s" .Theme))}}">
        <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          {{if eq .Theme "light"}}<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" stroke="currentColor" stroke-width="2"/>{{else if eq .Theme "auto"}}<path d="M12 2a10 10 0 1 0 0 20V2Z" fill="currentColor"/><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/>{{else}}<path d="M20.5 15.5A8.5 8.5 0 0 1 8.5 3.5 8.5 8.5 0 1 0 20.5 15.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>{{end}}
        </svg>
      </button>
    </form>
  </div>
  {{index .OperatorContents "header"}}
</header>
{{end}}
